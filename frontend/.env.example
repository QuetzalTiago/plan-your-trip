# Copy this to .env.local and fill in the values after deploying the CDK stack.
# Run `cdk deploy` and use the outputs to populate these values.

# API Gateway endpoint (from CDK output: ApiUrl)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Lambda Function URL for streaming (from CDK output: StreamFunctionUrl)
VITE_STREAM_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.us-east-1.on.aws
